@@ -0,0 +1,305 @@
+.admin-dashboard {
+  width: min(1280px, 92%);
+  margin: 2rem auto 5rem;
+  display: flex;
+  flex-direction: column;
+  gap: 1.5rem;
+}
+
+.admin-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 1rem;
+  padding: 2rem;
+  border-radius: 32px;
+  background: rgba(255, 255, 255, 0.88);
+  backdrop-filter: blur(18px);
+  border: 1px solid var(--border);
+  box-shadow: var(--shadow);
+}
+
+.app-dark .admin-header {
+  background: rgba(15, 23, 42, 0.88);
+}
+
+.admin-header h1 {
+  margin: 0 0 0.4rem;
+  font-size: clamp(2rem, 3vw, 3rem);
+  font-weight: 950;
+  letter-spacing: -0.06em;
+  color: var(--text-color);
+}
+
+.admin-header p {
+  margin: 0;
+  color: var(--muted-text);
+  font-weight: 600;
+}
+
+.admin-refresh-btn {
+  border: none;
+  border-radius: var(--radius-pill);
+  padding: 0.95rem 1.3rem;
+  background: var(--gradient-main);
+  color: white;
+  font-weight: 900;
+  cursor: pointer;
+  transition: 0.25s ease;
+  white-space: nowrap;
+}
+
+.admin-refresh-btn:hover {
+  transform: translateY(-3px);
+  box-shadow: 0 18px 35px rgba(37, 99, 235, 0.28);
+}
+
+/* STATS */
+
+.admin-stats-grid {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 1rem;
+}
+
+.admin-stat-card {
+  background: var(--surface);
+  border-radius: 28px;
+  padding: 1.4rem;
+  border: 1px solid var(--border);
+  box-shadow: var(--shadow);
+  transition: 0.25s ease;
+}
+
+.admin-stat-card:hover {
+  transform: translateY(-4px);
+}
+
+.admin-stat-card h3 {
+  margin: 0;
+  font-size: 2.3rem;
+  font-weight: 950;
+  letter-spacing: -0.05em;
+  color: var(--accent-color);
+}
+
+.admin-stat-card p {
+  margin-top: 0.35rem;
+  color: var(--muted-text);
+  font-weight: 700;
+}
+
+/* PANELS */
+
+.admin-panel {
+  background: var(--surface);
+  border-radius: 32px;
+  padding: 1.6rem;
+  border: 1px solid var(--border);
+  box-shadow: var(--shadow);
+}
+
+.admin-panel-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 1.5rem;
+  gap: 1rem;
+}
+
+.admin-panel-header h2 {
+  margin: 0;
+  font-size: 1.5rem;
+  letter-spacing: -0.04em;
+  color: var(--text-color);
+}
+
+/* TABLE */
+
+.admin-table-wrapper {
+  overflow-x: auto;
+}
+
+.admin-table {
+  width: 100%;
+  border-collapse: collapse;
+}
+
+.admin-table thead {
+  background: rgba(249, 115, 22, 0.08);
+}
+
+.admin-table th {
+  padding: 1rem;
+  text-align: left;
+  color: var(--text-color);
+  font-size: 0.9rem;
+  font-weight: 900;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+}
+
+.admin-table td {
+  padding: 1rem;
+  border-top: 1px solid var(--border);
+  color: var(--muted-text);
+  font-weight: 600;
+  vertical-align: middle;
+}
+
+.admin-table tr:hover {
+  background: rgba(249, 115, 22, 0.03);
+}
+
+.app-dark .admin-table tr:hover {
+  background: rgba(255, 255, 255, 0.03);
+}
+
+/* BADGES */
+
+.status-badge {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 0.45rem 0.8rem;
+  border-radius: var(--radius-pill);
+  font-size: 0.78rem;
+  font-weight: 900;
+  text-transform: uppercase;
+}
+
+.status-approved {
+  background: rgba(34, 197, 94, 0.15);
+  color: #16a34a;
+}
+
+.status-pending {
+  background: rgba(249, 115, 22, 0.16);
+  color: #ea580c;
+}
+
+.status-rejected {
+  background: rgba(239, 68, 68, 0.14);
+  color: #dc2626;
+}
+
+/* ACTIONS */
+
+.admin-actions {
+  display: flex;
+  gap: 0.7rem;
+  flex-wrap: wrap;
+}
+
+.admin-action-btn {
+  border: none;
+  border-radius: var(--radius-pill);
+  padding: 0.7rem 1rem;
+  font-weight: 800;
+  cursor: pointer;
+  transition: 0.25s ease;
+}
+
+.admin-action-btn.approve {
+  background: rgba(34, 197, 94, 0.15);
+  color: #15803d;
+}
+
+.admin-action-btn.reject {
+  background: rgba(239, 68, 68, 0.14);
+  color: #dc2626;
+}
+
+.admin-action-btn:hover {
+  transform: translateY(-2px);
+}
+
+/* ANALYTICS */
+
+.analytics-grid {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: 1rem;
+}
+
+.analytics-card {
+  background: var(--surface-soft);
+  border-radius: 24px;
+  padding: 1.4rem;
+  border: 1px solid var(--border);
+}
+
+.analytics-card h3 {
+  margin-bottom: 1rem;
+  color: var(--text-color);
+  font-size: 1.1rem;
+}
+
+.analytics-list {
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 0.8rem;
+}
+
+.analytics-list li {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  color: var(--muted-text);
+  font-weight: 700;
+}
+
+/* EMPTY STATE */
+
+.admin-empty {
+  padding: 4rem 1rem;
+  text-align: center;
+  color: var(--muted-text);
+}
+
+.admin-empty h3 {
+  margin-bottom: 0.5rem;
+  color: var(--text-color);
+}
+
+/* RESPONSIVE */
+
+@media (max-width: 1100px) {
+  .admin-stats-grid,
+  .analytics-grid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
+
+@media (max-width: 820px) {
+  .admin-header,
+  .admin-panel-header {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .admin-refresh-btn {
+    width: 100%;
+  }
+}
+
+@media (max-width: 640px) {
+  .admin-dashboard {
+    width: 94%;
+  }
+
+  .admin-stats-grid,
+  .analytics-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .admin-panel {
+    padding: 1.2rem;
+  }
+
+  .admin-table th,
+  .admin-table td {
+    padding: 0.8rem;
+  }
+}

+
+.view-header {
+  position: relative;
+
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+
+  gap: 1rem;
+
+  margin-bottom: 2rem;
+
+  padding: 2.2rem;
+
+  border-radius: 36px;
+
+  overflow: hidden;
+
+  background:
+    radial-gradient(
+      circle at top left,
+      rgba(255,255,255,0.16),
+      transparent 30%
+    ),
+    linear-gradient(
+      135deg,
+      #f97316,
+      #2563eb,
+      #f43f5e
+    );
+
+  color: white;
+
+  box-shadow:
+    0 28px 80px rgba(37, 99, 235, 0.22);
+}
+
+.view-header::after {
+  content: "";
+
+  position: absolute;
+  inset: 0;
+
+  background:
+    linear-gradient(
+      180deg,
+      rgba(255,255,255,0.04),
+      transparent
+    );
+
+  pointer-events: none;
+}
+
+.view-header h1 {
+  position: relative;
+  z-index: 1;
+
+  margin: 0 0 0.5rem;
+
+  font-size: clamp(2rem, 4vw, 3.2rem);
+
+  line-height: 1;
+
+  letter-spacing: -0.07em;
+
+  font-weight: 950;
+}
+
+.view-header p {
+  position: relative;
+  z-index: 1;
+
+  margin: 0;
+
+  color: rgba(255,255,255,0.82);
+
+  line-height: 1.7;
+
+  font-size: 1rem;
+}
+
+/* CLOSE BUTTON */
+
+.close-view-btn {
+  position: relative;
+  z-index: 1;
+
+  border: none;
+
+  padding: 0.95rem 1.4rem;
+
+  border-radius: 999px;
+
+  background: rgba(255,255,255,0.92);
+
+  color: #17131f;
+
+  font-weight: 900;
+
+  cursor: pointer;
+
+  transition:
+    transform 0.25s ease,
+    box-shadow 0.25s ease,
+    background 0.25s ease;
+}
+
+.close-view-btn:hover {
+  transform: translateY(-3px);
+
+  box-shadow:
+    0 18px 35px rgba(255,255,255,0.18);
+}
+
+.close-view-btn:active {
+  transform: translateY(-1px);
+}
+
+/* EMPTY / STATE WRAPPERS */
+
+.saved-events-view .state-view {
+  border-radius: 32px;
+
+  background: var(--surface);
+
+  border: 1px solid var(--border);
+
+  box-shadow: var(--shadow);
+}
+
+/* DARK MODE */
+
+.app-dark .view-header {
+  box-shadow:
+    0 28px 80px rgba(0, 0, 0, 0.42);
+}
+
+/* RESPONSIVE */
+
+@media (max-width: 768px) {
+  .saved-events-view {
+    width: 94%;
+    padding-top: 2rem;
+  }
+
+  .view-header {
+    flex-direction: column;
+    padding: 1.6rem;
+    border-radius: 28px;
+  }
+
+  .close-view-btn {
+    width: 100%;
+  }
+}
+
+@media (max-width: 520px) {
+  .view-header h1 {
+    font-size: 2.2rem;
+  }
+
+  .view-header p {
+    font-size: 0.95rem;
+  }
+}
